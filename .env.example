# Copia como .env (junto a compose.yaml). Solo rutas y ajustes: NUNCA claves aquí.
# Carpeta de trabajo de Jarvis en tu PC (lo único de tu disco que ve, aparte de la memoria).
JARVIS_WORK_DIR=C:/Users/TU_USUARIO/JarvisTrabajo
# Carpeta con memoria.md, para que puedas editarla tú.
JARVIS_MEMORY_DIR=C:/Users/TU_USUARIO/JarvisMemoria
# Vault de Obsidian SOLO de Jarvis (carpeta nueva, nunca tu vault personal).
JARVIS_VAULT_DIR=C:/Users/TU_USUARIO/JarvisVault
JARVIS_TZ=Europe/Madrid
# Web que abre la ventana de inicio de sesión (noVNC).
LOGIN_URL=https://accounts.google.com
